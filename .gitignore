# Temporary files, scheduler logs and scratch
*.tmp
*.partial
*.part
*.log
*.o[0-9]*
*.e[0-9]*
/tmp/
/.cache/
/blast/
*.sif
*.simg

# Large sequencing and alignment files
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai

# Species references and normal outputs remain trackable.
# No blanket resources/ or output/ exclusions.

# Machine-specific runtime state
/output/**/logs/
/output/**/cache/
/output/**/tmp/
/output/**/manifests/jobs/
/output/**/manifests/argon/
/output/**/manifests/orchestrator/current_job.json
/output/**/config/argon_fastq_inputs/


