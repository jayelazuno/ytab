# OS
docs/codex/
.DS_Store
**/.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
env/

# R
.Rhistory
.RData
.Rproj.user/

# Nextflow
work/
.nextflow/
.nextflow.log
.timeline.html
.report.html
.trace.txt
.dag.html

# -----------------------
# # YTAB species resources
# # Track curated metadata and small support tables
# # Ignore bulky reference assets and aligner indexes
# # -----------------------
#
# # Keep documentation / manifests
!resources/
!resources/species/
!resources/species/**/
!resources/species/**/README.md
!resources/species/**/*.md
!resources/species/**/*.json
!resources/species/**/*.yaml
!resources/species/**/*.yml
!resources/species/**/*.tsv
!resources/species/**/*.csv
!resources/species/**/*.bed
!resources/species/**/*ortholog*.txt
!resources/species/**/*feature_count*.txt

# # Ignore large reference genome assets
resources/species/**/*.fna
resources/species/**/*.fa
resources/species/**/*.fasta
resources/species/**/*.faa
resources/species/**/*.gff
resources/species/**/*.gff3
resources/species/**/*.gtf

# # Ignore aligner indexes
resources/species/**/*.bt2
resources/species/**/*.bt2l

# # Optional: ignore common sequence index byproducts
resources/species/**/*.fai
resources/species/**/*.dict
resources/species/**/*.nhr
resources/species/**/*.nin
resources/species/**/*.nsq

# InterProScan outputs
resources/species/**/interproscan6/*.json
resources/species/**/interproscan6/*.jsonl
resources/species/**/interproscan6/*.tsv
resources/species/**/interproscan6/*.xml

# Outputs / generated project artifacts
# Ignore generated project/export outputs by default. Curated hosted deployment
# bundles can be explicitly unignored by path later when they are intentionally
# prepared for release.
output/**
!output/
!output/projects/
!output/exports/
!output/**/.gitkeep

# App-development/demo projects intentionally committed for local collaboration.
# Keep these available after clone so collaborators can open the Shiny app with
# real project state without regenerating the full pipeline.
!output/projects/H2O2_screen_v1/
!output/projects/H2O2_screen_v1/**
!output/projects/local_glabrata_smoke_v1/
!output/projects/local_glabrata_smoke_v1/**
!output/exports/H2O2_screen_v1/
!output/exports/H2O2_screen_v1/**
!output/exports/local_glabrata_smoke_v1/
!output/exports/local_glabrata_smoke_v1/**

# # ignore heavy sequencing / alignment files
output/**/*.fastq
output/**/*.fastq.gz
output/**/*.fq
output/**/*.fq.gz
output/**/*.bam
output/**/*.bai
output/**/*.sam
output/**/*.cram

# # optional: also ignore other heavy intermediates if needed later
output/**/*.sorted
output/**/*.tmp
output/**/*.log

# Keep OS metadata ignored even inside explicitly unignored project/export trees.
.DS_Store
**/.DS_Store

# pipeline log files
pipeline/**/*.log

# Containers / temp
tmp/
.cache/

# notes
codex/
codex/ui_references/
codex/ui_references/**

# Generated local YTAB projects and exports
#output/projects/
#output/exports/
#resources/species/*/reference_genome/reference_prepare_manifest.json
