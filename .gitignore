
#OS, editors and local notes
.DS_Store
._*
*.swp
*.swo
*~
*.bak
*.bak_*
.vscode/
.idea/
/codex/
/docs/codex/

# Environments and language caches
# Keep envs/*.yml and environment.local.yml trackable
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
/venv/
/.conda/
.Rhistory
.RData
.Rproj.user/
.Renviron
.env
.env.*
!.env.example

# Temporary files, scheduler logs and scratch
*.tmp
*.partial
*.part
*.log
*.o[0-9]*
*.e[0-9]*
/tmp/
/.cache/
/blast/
*.sif
*.simg

# Large sequencing and alignment files
*.fastq
*.fastq.gz
# The Gale et al. 2020 read subsample is the one exception: it ships with the app so the mapping stage can be run
# on first launch. It is 200,000 read pairs per library fetched from ENA, not the full libraries.
!/data/fastq/gale_2020/**/*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai

# Species references remain trackable.
# Processed datasets do NOT travel with the repository: they are published on Zenodo and fetched per dataset from
# the app's Datasets page, so a clone stays small enough to be useful. Gale et al. 2020 is the exception, because it
# is the worked example the tutorial and the benchmarks use, and it ships with the app.
/output/projects/*
!/output/projects/Gale_2020/
/output/exports/*
!/output/exports/Gale_2020/

# Machine-specific runtime state
/output/**/logs/
/output/**/cache/
/output/**/tmp/
# The legacy MidLC normalization targets (T013p239, T409600). Superseded by the named method targets
# (betageom__*, midlc__*, ttr__*) and wrong either way, so they neither ship nor get published.
/output/**/T013p239/
/output/**/T409600/
/output/**/T013p239.*
/output/**/T409600.*
# Dataset archives built for publication: large, regenerable, and published on Zenodo rather than in git.
/output/zenodo/
/output/**/bundles/
/output/**/manifests/jobs/
/output/**/manifests/argon/
/output/**/manifests/orchestrator/current_job.json
/output/**/config/argon_fastq_inputs/


# Obsolete material kept for reference, not part of the app (see archive/ARCHIVE_MANIFEST.md)
/archive/
# Method-comparison study (z-score vs resampling vs Gumbel vs published calls): local curiosity, never tracked.
/output/comparison/
/output/claims_check/

# Research, benchmarking and presentation material: kept locally, not part of the app or its data.
# The app, its documentation, the pipelines and the reprocessed project data all stay tracked.
/docs/manuscript/
/scripts/paper/
/output/paper/
/output/e2e_benchmark/
/output/ui_benchmark/
/output/public_expansion/
/output/public_expansion_2/
/output/ade2_jackpot/
/scripts/local/ytab_e2e_benchmark.py
/scripts/local/ytab_ui_benchmark.R
/scripts/local/ytab_pool_comparison_slides.R
/scripts/local/ytab_public_expansion.py
/scripts/local/ytab_power_audit.py
/scripts/local/ytab_ade2_jackpot.py
